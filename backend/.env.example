# ---------- Django 基础 ----------
DJANGO_DEBUG=true
# 生产必须替换：openssl rand -hex 32
DJANGO_SECRET_KEY=dev-only-change-me-please-32bytes-min
ALLOWED_HOSTS=*
# 逗号分隔；生产收紧为真实前端域名
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_TIMEZONE=Asia/Shanghai
DEFAULT_PAGE_SIZE=20

# ---------- 数据库 ----------
# 本地开发默认 SQLite，零依赖即可启动；正式环境改成 MySQL（见 docker-compose.yml）
DATABASE_URL=sqlite:///./data/football.db
# DATABASE_URL=mysql+pymysql://football:football@127.0.0.1:3306/football?charset=utf8mb4

# ---------- 缓存 / 令牌撤销 ----------
# 留空则用进程内缓存（单机可用）；多实例部署必须配 Redis
REDIS_URL=

# ---------- 安全 ----------
JWT_SECRET=dev-only-change-me-please-32bytes-min
ACCESS_TOKEN_TTL_MINUTES=120
# 身份证/手机号 AES-GCM 主密钥，必须是 32 字节的 base64；留空则从 JWT_SECRET 派生
CRYPTO_KEY=

# ---------- 限流 ----------
THROTTLE_LOGIN=30/min
THROTTLE_REGISTRATION=20/min
THROTTLE_POLICY_QUESTION=20/hour

# ---------- 文件存储 ----------
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/files
MAX_FILE_SIZE_MB=10
MAX_BATCH_FILES=100
MAX_BATCH_TOTAL_MB=50
# 私有文件受控下载链接有效期（秒）
FILE_TICKET_TTL_SECONDS=300
# MinIO（STORAGE_BACKEND=minio 时生效）
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=football
MINIO_SECURE=false

# ---------- 人脸核验（D1 确认是否接第三方；默认现场拍照 + 人工确认） ----------
FACE_MODE=MANUAL
FACE_API_BASE=
FACE_API_KEY=
FACE_THRESHOLD=0.75

# ---------- 政策问答（项目唯一 AI；可一键关闭） ----------
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=15
AI_MAX_QUESTION_CHARS=1000
AI_RATE_LIMIT_PER_HOUR=20

# ---------- 日志 ----------
LOG_LEVEL=INFO
